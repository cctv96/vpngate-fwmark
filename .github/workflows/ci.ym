name: CI

on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:
    branches: [main]

permissions:
  contents: read

jobs:
  test:
    name: Test (Python ${{ matrix.python-version }})
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.11", "3.12"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Compile main program
        run: python3 -m py_compile vpngate-fwmark.py
      - name: Check shell scripts
        run: |
          bash -n install.sh
          bash -n upgrade.sh
          bash -n uninstall.sh
      - name: Run unit tests
        run: python3 -m unittest discover -s tests -v

  package:
    name: Package
    runs-on: ubuntu-latest
    needs: test
    steps:
      - uses: actions/checkout@v4
      - name: Build zip package
        run: |
          rm -f vpngate-fwmark.zip
          zip -r vpngate-fwmark.zip vpngate-fwmark.py install.sh upgrade.sh uninstall.sh \
            vpngate-fwmark-watch.service vpngate-fwmark-watch.timer README.md LICENSE
          ls -lh vpngate-fwmark.zip
      - uses: actions/upload-artifact@v4
        with:
          name: vpngate-fwmark
          path: vpngate-fwmark.zip
          if-no-files-found: error

  release:
    name: Release
    runs-on: ubuntu-latest
    needs: package
    if: startsWith(github.ref, 'refs/tags/v')
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - name: Build zip package
        run: |
          zip -r vpngate-fwmark.zip vpngate-fwmark.py install.sh upgrade.sh uninstall.sh \
            vpngate-fwmark-watch.service vpngate-fwmark-watch.timer README.md LICENSE
      - uses: softprops/action-gh-release@v2
        with:
          files: vpngate-fwmark.zip
          generate_release_notes: true
